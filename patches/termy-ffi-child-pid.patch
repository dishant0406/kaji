+fn selected_text_from_term<T: EventListener>(
+    term: &Term<T>,
+    anchor_row: usize,
+    anchor_col: usize,
+    active_row: usize,
+    active_col: usize,
+) -> Option<String> {
+    let grid = term.grid();
+    let cols = grid.columns();
+    let total_lines = grid.total_lines();
+    if cols == 0 || total_lines == 0 {
+        return None;
+    }
+
+    let ((start_row, start_col), (end_row, end_col)) =
+        if (anchor_row, anchor_col) <= (active_row, active_col) {
+            ((anchor_row, anchor_col), (active_row, active_col))
+        } else {
+            ((active_row, active_col), (anchor_row, anchor_col))
+        };
+    let max_row = total_lines.saturating_sub(1);
+    let start_row = start_row.min(max_row);
+    let end_row = end_row.min(max_row);
+    if start_row > end_row {
+        return None;
+    }
+
+    let history_size = grid.history_size();
+    let max_col = cols.saturating_sub(1);
+    let lines = (start_row..=end_row)
+        .map(|absolute_row| {
+            let line = Line(absolute_row as i32 - history_size as i32);
+            let start = if absolute_row == start_row {
+                start_col.min(max_col)
+            } else {
+                0
+            };
+            let end = if absolute_row == end_row {
+                end_col.min(max_col)
+            } else {
+                max_col
+            };
+            grid_line_text(term, line, cols)
+                .chars()
+                .skip(start)
+                .take(end.saturating_sub(start).saturating_add(1))
+                .collect::<String>()
+                .trim_end()
+                .to_string()
+        })
+        .collect::<Vec<_>>();
+    let text = lines.join("\n");
+    if text.is_empty() { None } else { Some(text) }
 }
 
