+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn termy_terminal_child_pid(
+    terminal: *mut TermyFfiTerminal,
+    out_pid: *mut u32,
+) -> TermyFfiStatus {
+    ffi_status_guard(|| {
+        if terminal.is_null() || out_pid.is_null() {
+            return TermyFfiStatus::Null;
+        }
+
+        unsafe {
+            *out_pid = (*terminal).terminal.child_pid().unwrap_or(0);
+        }
+        TermyFfiStatus::Ok
+    })
+}
