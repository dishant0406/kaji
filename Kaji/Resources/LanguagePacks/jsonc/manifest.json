{
  "schemaVersion": 1,
  "id": "jsonc",
  "name": "JSON with Comments",
  "extensions": [
    "jsonc",
    "json5"
  ],
  "filenames": [],
  "configuration": {
    "comments": {
      "lineComment": "//",
      "blockComment": [
        "/*",
        "*/"
      ]
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ]
    ],
    "autoClosingPairs": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "\"",
        "\""
      ]
    ],
    "surroundingPairs": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "\"",
        "\""
      ]
    ],
    "indentationRules": null,
    "folding": null
  },
  "syntax": {
    "engine": "builtInTokenizer",
    "builtInTokenizer": {
      "grammarID": "jsonc"
    }
  },
  "lsp": null,
  "snippets": [],
  "formatter": null
}
