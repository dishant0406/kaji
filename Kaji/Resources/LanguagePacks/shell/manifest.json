{
  "schemaVersion": 1,
  "id": "shell",
  "name": "Shell",
  "extensions": [
    "sh",
    "bash",
    "zsh",
    "fish"
  ],
  "filenames": [
    ".bashrc",
    ".zshrc",
    ".zshenv",
    ".profile",
    "bashrc",
    "zshrc"
  ],
  "configuration": {
    "comments": {
      "lineComment": "#"
    },
    "brackets": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ]
    ],
    "autoClosingPairs": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ],
      [
        "\"",
        "\""
      ],
      [
        "'",
        "'"
      ]
    ],
    "surroundingPairs": [
      [
        "{",
        "}"
      ],
      [
        "[",
        "]"
      ],
      [
        "(",
        ")"
      ],
      [
        "\"",
        "\""
      ],
      [
        "'",
        "'"
      ]
    ],
    "indentationRules": null,
    "folding": null
  },
  "syntax": {
    "engine": "builtInTokenizer",
    "builtInTokenizer": {
      "grammarID": "shell"
    }
  },
  "lsp": null,
  "snippets": [],
  "formatter": null
}
